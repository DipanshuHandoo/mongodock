{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "checkJs": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/esm"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "test"]
}
